#@baseUrl = http://localhost:8080
#@token = replace-with-valid-jwt
#@userId = replace-with-user-uuid
#
#### UM-01: List users - success
#GET {{baseUrl}}/api/users?page=0&size=10&keyword=&role=All&departmentName=All&status=All
#Authorization: Bearer {{token}}
#Accept: application/json
#
#### UM-02: List users with role and status filters
#GET {{baseUrl}}/api/users?page=0&size=10&keyword=lan&role=Employee&departmentName=Engineering&status=ACTIVE
#Authorization: Bearer {{token}}
#Accept: application/json
#
#### UM-03: View a permitted user
#GET {{baseUrl}}/api/users/{{userId}}
#Authorization: Bearer {{token}}
#Accept: application/json
#
#### UM-04: View an unknown user - expected 404
#GET {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000
#Authorization: Bearer {{token}}
#Accept: application/json
#
#### UM-05: Create an employee
