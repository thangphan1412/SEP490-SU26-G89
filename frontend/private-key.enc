const downloadPrivateKeyBackup = (encryptedData) => {
    const blob = new Blob(
        [
            JSON.stringify(
                encryptedData,
                null,
                2
            ),
        ],
        {
            type: "application/octet-stream",
        }
    );

    const url =
        URL.createObjectURL(blob);

    const a =
        document.createElement("a");

    a.href = url;
    a.download = "private-key.enc";

    document.body.appendChild(a);

    a.click();

    a.remove();

    URL.revokeObjectURL(url);
};