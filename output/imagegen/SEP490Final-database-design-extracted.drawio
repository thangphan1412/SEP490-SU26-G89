  <diagram id="ImyLyqr3_ySXRx7QT91Q" name="database design">
    <mxGraphModel dx="4387" dy="3149" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n\n    USERS {\n        UUID id PK\n        VARCHAR username\n        VARCHAR email\n        VARCHAR password\n        VARCHAR full_name\n        VARCHAR status\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    ROLE {\n        UUID id PK\n        VARCHAR name\n        VARCHAR description\n        VARCHAR status\n    }\n\n    PERMISSION_ACTION {\n        UUID id PK\n        VARCHAR action_code\n        VARCHAR action_name\n        VARCHAR description\n    }\n\n    PERMISSIONS {\n        UUID id PK\n        UUID project_id FK\n        UUID role_id FK\n        UUID action_id FK\n        VARCHAR status\n    }\n\n    USER_ROLE {\n        UUID id PK\n        UUID user_id FK\n        UUID role_id FK\n    }\n\n    USER_PERMISSION {\n        UUID id PK\n        UUID user_id FK\n        UUID permission_id FK\n    }\n\n    COMPANY {\n        UUID id PK\n        VARCHAR company_name\n        VARCHAR tax_code\n        VARCHAR address\n        VARCHAR phone\n        VARCHAR email\n        VARCHAR status\n    }\n\n    DEPARTMENTS {\n        UUID id PK\n        UUID company_id FK\n        VARCHAR department_name\n        VARCHAR description\n        VARCHAR status\n    }\n\n    PROJECTS {\n        UUID id PK\n        UUID company_id FK\n        UUID manager_id FK\n        VARCHAR project_code\n        VARCHAR project_name\n        VARCHAR description\n        VARCHAR status\n        DATE start_date\n        DATE end_date\n    }\n\n    PROJECT_MEMBER {\n        UUID id PK\n        UUID project_id FK\n        UUID user_id FK\n        UUID role_id FK\n        VARCHAR status\n    }\n\n    CONTRACT_TYPES {\n        UUID id PK\n        VARCHAR type_name\n        VARCHAR description\n        VARCHAR status\n    }\n\n    CONTRACT_TEMPLATES {\n        UUID id PK\n        UUID company_id FK\n        UUID contract_type_id FK\n        VARCHAR template_name\n        VARCHAR description\n        VARCHAR status\n    }\n\n    CONTRACT_TEMPLATE_VERSIONS {\n        UUID id PK\n        UUID template_id FK\n        VARCHAR version_number\n        TEXT layout\n        VARCHAR status\n        DATETIME created_at\n    }\n\n    CONTRACTS {\n        UUID id PK\n        UUID project_id FK\n        UUID contract_type_id FK\n        UUID template_id FK\n        UUID template_version_id FK\n        UUID created_by FK\n        VARCHAR contract_number\n        VARCHAR title\n        VARCHAR status\n        DATE start_date\n        DATE end_date\n        TEXT content\n    }\n\n    CONTRACT_ATTRIBUTE {\n        UUID id PK\n        UUID contract_type_id FK\n        VARCHAR attribute_name\n        VARCHAR data_type\n        BOOLEAN required\n    }\n\n    CONTRACT_ATTRIBUTE_VALUES {\n        UUID id PK\n        UUID contract_id FK\n        UUID attribute_id FK\n        TEXT attribute_value\n    }\n\n    CONTRACT_POSITIONS {\n        UUID id PK\n        UUID contract_id FK\n        VARCHAR position_code\n        VARCHAR position_name\n        DECIMAL position_x\n        DECIMAL position_y\n        DECIMAL width\n        DECIMAL height\n    }\n\n    CONTRACT_STATUS_HISTORY {\n        UUID id PK\n        UUID contract_id FK\n        UUID changed_by FK\n        VARCHAR old_status\n        VARCHAR new_status\n        TEXT reason\n        DATETIME created_at\n    }\n\n    CONTRACT_APPROVALS {\n        UUID id PK\n        UUID contract_id FK\n        UUID approver_id FK\n        VARCHAR status\n        TEXT comment\n        DATETIME approved_at\n    }\n\n    APPROVALS {\n        UUID id PK\n        UUID contract_id FK\n        UUID user_id FK\n        VARCHAR approval_type\n        VARCHAR status\n        TEXT comment\n        DATETIME created_at\n    }\n\n    WORKFLOW {\n        UUID id PK\n        UUID company_id FK\n        VARCHAR workflow_name\n        VARCHAR description\n        VARCHAR status\n    }\n\n    WORKFLOW_STEPS {\n        UUID id PK\n        UUID workflow_id FK\n        VARCHAR step_name\n        INT step_order\n        VARCHAR role_code\n        VARCHAR status\n    }\n\n    CONTRACT_TYPE_WORKFLOW {\n        UUID id PK\n        UUID contract_type_id FK\n        UUID workflow_id FK\n    }\n\n    CONTRACT_TYPE_WORKFLOW_STEP {\n        UUID id PK\n        UUID contract_type_workflow_id FK\n        UUID workflow_step_id FK\n    }\n\n    CONTRACT_WORKFLOW_STEP_INSTANCE {\n        UUID id PK\n        UUID contract_id FK\n        UUID workflow_step_id FK\n        UUID assigned_user_id FK\n        VARCHAR status\n        DATETIME completed_at\n    }\n\n    FILE_STORAGE {\n        UUID id PK\n        UUID uploaded_by FK\n        VARCHAR file_name\n        VARCHAR file_path\n        VARCHAR file_type\n        BIGINT file_size\n        VARCHAR storage_provider\n    }\n\n    ELECTRONIC_SIGNATURES {\n        UUID id PK\n        UUID user_id FK\n        UUID file_storage_id FK\n        VARCHAR signature_name\n        VARCHAR signature_type\n        BOOLEAN is_default\n        VARCHAR status\n    }\n\n    USER_KEYS {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR algorithm\n        VARCHAR key_code\n        INT key_size\n        TEXT public_key\n        VARCHAR public_key_fingerprint\n        DATETIME created_at\n    }\n\n    SIGNATURE {\n        UUID id PK\n        UUID contract_id FK\n        UUID user_id FK\n        UUID electronic_signature_id FK\n        UUID file_storage_id FK\n        VARCHAR signature_status\n        VARCHAR action\n        TEXT document_hash\n        DATETIME signed_at\n    }\n\n    EXTERNAL_ACCESS {\n        UUID id PK\n        UUID contract_id FK\n        UUID created_by FK\n        VARCHAR access_token\n        DATETIME expired_at\n        VARCHAR status\n    }\n\n    NOTIFICATIONS {\n        UUID id PK\n        UUID user_id FK\n        UUID contract_id FK\n        VARCHAR title\n        TEXT message\n        BOOLEAN is_read\n        DATETIME created_at\n    }\n\n    TIMELINE {\n        UUID id PK\n        UUID project_id FK\n        VARCHAR timeline_name\n        DATE start_date\n        DATE end_date\n        VARCHAR status\n    }\n\n    TIMELINE_TASK {\n        UUID id PK\n        UUID timeline_id FK\n        VARCHAR task_name\n        DATE start_date\n        DATE end_date\n        VARCHAR status\n    }\n\n    TIMELINE_CONTRACT {\n        UUID id PK\n        UUID timeline_id FK\n        UUID contract_id FK\n    }\n\n    DELIVERABLE {\n        UUID id PK\n        UUID timeline_task_id FK\n        VARCHAR deliverable_name\n        TEXT description\n        VARCHAR status\n        DATE due_date\n    }\n\n    ACTIVITY_LOG {\n        UUID id PK\n        UUID user_id FK\n        UUID contract_id FK\n        VARCHAR action\n        TEXT description\n        DATETIME created_at\n    }\n\n    PROPOSALS {\n        UUID id PK\n        UUID project_id FK\n        UUID created_by FK\n        VARCHAR title\n        TEXT description\n        VARCHAR status\n        DATETIME created_at\n    }\n\n\n    USERS ||--o{ USER_ROLE : has\n    ROLE ||--o{ USER_ROLE : assigned\n\n    USERS ||--o{ USER_PERMISSION : has\n    PERMISSIONS ||--o{ USER_PERMISSION : grants\n\n    PROJECTS ||--o{ PERMISSIONS : contains\n    ROLE ||--o{ PERMISSIONS : receives\n    PERMISSION_ACTION ||--o{ PERMISSIONS : defines\n\n    COMPANY ||--o{ DEPARTMENTS : owns\n    COMPANY ||--o{ PROJECTS : owns\n    COMPANY ||--o{ CONTRACT_TEMPLATES : owns\n    COMPANY ||--o{ WORKFLOW : owns\n\n    USERS ||--o{ PROJECTS : manages\n\n    PROJECTS ||--o{ PROJECT_MEMBER : contains\n    USERS ||--o{ PROJECT_MEMBER : joins\n    ROLE ||--o{ PROJECT_MEMBER : assigned\n\n    CONTRACT_TYPES ||--o{ CONTRACT_TEMPLATES : categorizes\n    CONTRACT_TEMPLATES ||--o{ CONTRACT_TEMPLATE_VERSIONS : versions\n\n    PROJECTS ||--o{ CONTRACTS : contains\n    CONTRACT_TYPES ||--o{ CONTRACTS : categorizes\n    CONTRACT_TEMPLATES ||--o{ CONTRACTS : uses\n    CONTRACT_TEMPLATE_VERSIONS ||--o{ CONTRACTS : uses\n    USERS ||--o{ CONTRACTS : creates\n\n    CONTRACT_TYPES ||--o{ CONTRACT_ATTRIBUTE : defines\n    CONTRACTS ||--o{ CONTRACT_ATTRIBUTE_VALUES : has\n    CONTRACT_ATTRIBUTE ||--o{ CONTRACT_ATTRIBUTE_VALUES : stores\n\n    CONTRACTS ||--o{ CONTRACT_POSITIONS : contains\n\n    CONTRACTS ||--o{ CONTRACT_STATUS_HISTORY : tracks\n    USERS ||--o{ CONTRACT_STATUS_HISTORY : changes\n\n    CONTRACTS ||--o{ CONTRACT_APPROVALS : requires\n    USERS ||--o{ CONTRACT_APPROVALS : approves\n\n    CONTRACTS ||--o{ APPROVALS : has\n    USERS ||--o{ APPROVALS : performs\n\n    WORKFLOW ||--o{ WORKFLOW_STEPS : contains\n\n    CONTRACT_TYPES ||--o{ CONTRACT_TYPE_WORKFLOW : uses\n    WORKFLOW ||--o{ CONTRACT_TYPE_WORKFLOW : assigned\n\n    CONTRACT_TYPE_WORKFLOW ||--o{ CONTRACT_TYPE_WORKFLOW_STEP : contains\n    WORKFLOW_STEPS ||--o{ CONTRACT_TYPE_WORKFLOW_STEP : defines\n\n    CONTRACTS ||--o{ CONTRACT_WORKFLOW_STEP_INSTANCE : executes\n    WORKFLOW_STEPS ||--o{ CONTRACT_WORKFLOW_STEP_INSTANCE : instantiates\n    USERS ||--o{ CONTRACT_WORKFLOW_STEP_INSTANCE : assigned\n\n    USERS ||--o{ FILE_STORAGE : uploads\n\n    FILE_STORAGE ||--o{ ELECTRONIC_SIGNATURES : stores\n    USERS ||--o{ ELECTRONIC_SIGNATURES : owns\n\n    USERS ||--o{ USER_KEYS : owns\n\n    CONTRACTS ||--o{ SIGNATURE : receives\n    USERS ||--o{ SIGNATURE : signs\n    ELECTRONIC_SIGNATURES ||--o{ SIGNATURE : uses\n    FILE_STORAGE ||--o{ SIGNATURE : stores\n\n    CONTRACTS ||--o{ EXTERNAL_ACCESS : shares\n    USERS ||--o{ EXTERNAL_ACCESS : creates\n\n    USERS ||--o{ NOTIFICATIONS : receives\n    CONTRACTS ||--o{ NOTIFICATIONS : triggers\n\n    PROJECTS ||--o{ TIMELINE : contains\n    TIMELINE ||--o{ TIMELINE_TASK : contains\n\n    TIMELINE ||--o{ TIMELINE_CONTRACT : links\n    CONTRACTS ||--o{ TIMELINE_CONTRACT : links\n\n    TIMELINE_TASK ||--o{ DELIVERABLE : produces\n\n    USERS ||--o{ ACTIVITY_LOG : performs\n    CONTRACTS ||--o{ ACTIVITY_LOG : logs\n\n    PROJECTS ||--o{ PROPOSALS : contains\n    USERS ||--o{ PROPOSALS : creates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dr9_EiHPg2bATmY501Fp-1">
