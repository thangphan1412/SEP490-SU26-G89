  <diagram id="V3KcfJq3iwgkHSvHE74x" name="Authentication diagrams">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class AuthenticateController {\n        &lt;&lt;RestController&gt;&gt;\n        -AuthenticationManager authenticationManager\n        -JWTService jwtService\n        -UserServiceImpl userServiceImpl\n        -UserKeysRepository userKeysRepository\n        +authenticateUser(AuthenticateRequest request) ResponseEntity\n        +forGotPassword(ForgotPasswordRequest request) ResponseEntity\n        +resetPasswrod(ResetPasswordRequest request) ResponseEntity\n        +resetPassword(ChangePasswordRequest request) ResponseEntity\n        -primaryRoleName(Users user) String\n    }\n\n    class AuthenticationManager {\n        &lt;&lt;Spring Security&gt;&gt;\n        +authenticate(Authentication authentication) Authentication\n    }\n\n    class UserDetailService {\n        &lt;&lt;Service&gt;&gt;\n        -UserRepository userRepository\n        +loadUserByUsername(String email) UserDetails\n    }\n\n    class MyUserDetail {\n        &lt;&lt;UserDetails&gt;&gt;\n        -Users users\n        +getAuthorities() Collection~GrantedAuthority~\n        +getPassword() String\n        +getUsername() String\n    }\n\n    class JWTService {\n        &lt;&lt;Service&gt;&gt;\n        -String SECRET_KEY\n        -Long expiration\n        +generateToken(UserDetails userDetails) String\n        +extractUsername(String token) String\n        +isTokenValid(String token, MyUserDetail userDetail) Boolean\n    }\n\n    class UserServiceImpl {\n        &lt;&lt;Service&gt;&gt;\n        -UserRepository userRepository\n        -PasswordEncoder passwordEncoder\n        -OTPGenerator otpGenerator\n        -RedisOtpService redisOtpService\n        -EmailService emailService\n        -CurrentUser currentUser\n        +forgotPassword(String email) void\n        +resetPassword(ResetPasswordRequest request) void\n        +changePassword(ChangePasswordRequest request) void\n    }\n\n    class UserRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +findByEmail(String email) Optional~Users~\n        +save(Users user) Users\n    }\n\n    class UserKeysRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +existsAllByKeyStatus(UUID userId, KeyStatus status) boolean\n    }\n\n    class CurrentUser {\n        &lt;&lt;Service&gt;&gt;\n        -UserRepository userRepository\n        +getCurrentUser() Users\n    }\n\n    class PasswordEncoder {\n        &lt;&lt;Spring Security&gt;&gt;\n        +matches(String rawPassword, String encodedPassword) boolean\n        +encode(String rawPassword) String\n    }\n\n    class OTPGenerator {\n        &lt;&lt;Component&gt;&gt;\n        +generateOTP() String\n    }\n\n    class RedisOtpService {\n        &lt;&lt;Service&gt;&gt;\n        -RedisTemplate redisTemplate\n        +saveOTP(String email, String otp) void\n        +getOTP(String email) String\n        +deleteOTP(String email) void\n    }\n\n    class EmailService {\n        &lt;&lt;Service&gt;&gt;\n        -JavaMailSender mailSender\n        +sendEmail(MessageInfor message) void\n    }\n\n    class MessageInfor {\n        &lt;&lt;DTO&gt;&gt;\n        -String email\n        -String title\n        -String text\n    }\n\n    class AuthenticateRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        -String email\n        -String password\n    }\n\n    class AuthenticateResponse {\n        &lt;&lt;ResponseDTO&gt;&gt;\n        -String token\n        -String role\n        -String fullName\n        -String departmentName\n        -boolean hasSignatureKey\n    }\n\n    class ForgotPasswordRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        -String email\n    }\n\n    class ResetPasswordRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        -String email\n        -String otp\n        -String newPassword\n        -String newPasswordConfirm\n    }\n\n    class ChangePasswordRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        -String oldPassword\n        -String newPassword\n        -String newPasswordConfirm\n    }\n\n    class Users {\n        &lt;&lt;Entity&gt;&gt;\n        -String email\n        -String password\n        -String firstName\n        -String lastName\n        -UserStatus status\n        -Departments department\n        -List~UserRole~ userRoles\n        -List~UserKeys~ userKeys\n    }\n\n    class UserRole {\n        &lt;&lt;Entity&gt;&gt;\n        -Users user\n        -Role role\n    }\n\n    class Role {\n        &lt;&lt;Entity&gt;&gt;\n        -String roleName\n    }\n\n    class UserKeys {\n        &lt;&lt;Entity&gt;&gt;\n        -String keyCode\n        -KeyStatus keyStatus\n        -Users user\n    }\n\n    AuthenticateController ..&gt; AuthenticateRequest : receives\n    AuthenticateController ..&gt; AuthenticateResponse : returns\n    AuthenticateController ..&gt; ForgotPasswordRequest : receives\n    AuthenticateController ..&gt; ResetPasswordRequest : receives\n    AuthenticateController ..&gt; ChangePasswordRequest : receives\n    AuthenticateController ..&gt; AuthenticationManager : authenticates\n    AuthenticateController ..&gt; JWTService : creates token\n    AuthenticateController ..&gt; UserServiceImpl : delegates password flows\n    AuthenticateController ..&gt; UserKeysRepository : checks signing key\n    AuthenticationManager ..&gt; UserDetailService : loads account\n    UserDetailService ..&gt; UserRepository : queries\n    UserDetailService ..&gt; MyUserDetail : creates\n    MyUserDetail --&gt; Users : wraps\n    UserServiceImpl ..&gt; UserRepository : queries and saves\n    UserServiceImpl ..&gt; PasswordEncoder : verifies and hashes\n    UserServiceImpl ..&gt; OTPGenerator : generates OTP\n    UserServiceImpl ..&gt; RedisOtpService : stores OTP\n    UserServiceImpl ..&gt; EmailService : sends OTP\n    UserServiceImpl ..&gt; CurrentUser : gets authenticated user\n    EmailService ..&gt; MessageInfor : receives\n    CurrentUser ..&gt; UserRepository : loads user\n    Users \&quot;1\&quot; --&gt; \&quot;0..*\&quot; UserRole : has\n    UserRole \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Role : references\n    Users \&quot;1\&quot; --&gt; \&quot;0..*\&quot; UserKeys : owns&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bsseD8YnWLm_AsnY-aXH-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
