  <diagram id="Ho4HXlSkTuI1Cn6WzAv3" name="Sequence Diagram (UserManagement-Update User)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\nautonumber\nactor A as Accountant / HeadOfDepartment\nparticipant UI as UpdateUser.jsx\nparticipant Sec as Spring Security\nparticipant C as UserController\nparticipant S as UserServiceImpl\nparticipant UR as UserRepository\nparticipant CU as CurrentUser\nparticipant DR as DepartmentRepository\nparticipant RR as RoleRepository\nparticipant URR as UserRoleRepository\nparticipant CR as CompanyRepository\nparticipant PE as PasswordEncoder\nparticipant ES as EmailService\n\nA-&gt;&gt;UI: Submit edited user form\nUI-&gt;&gt;C: PUT /api/users/{id} + UserUpdateRequestDTO\nC-&gt;&gt;Sec: Check Accountant or HeadOfDepartment\nSec--&gt;&gt;C: Authorized\nC-&gt;&gt;S: updateUser(id, request)\n\nS-&gt;&gt;UR: findById(id)\nUR--&gt;&gt;S: Target Users\nS-&gt;&gt;CU: getCurrentUser()\nCU--&gt;&gt;S: Logged-in Users\nS-&gt;&gt;S: Validate role and department access\n\nS-&gt;&gt;DR: findByDepartmentName(departmentName)\nDR--&gt;&gt;S: Departments\n\nopt Role is changed\n  S-&gt;&gt;RR: findByRoleName(role)\n  RR--&gt;&gt;S: Role\n  S-&gt;&gt;URR: save(updated UserRole)\nend\n\nopt Password is provided\n  S-&gt;&gt;PE: encode(password)\n  PE--&gt;&gt;S: Encoded password\nend\n\nopt Target role is External Parners\n  S-&gt;&gt;CR: save(updated external company)\nend\n\nS-&gt;&gt;UR: save(updated Users)\nUR--&gt;&gt;S: Saved Users\n\nopt sendWelcomeEmail = true\n  S-&gt;&gt;ES: sendEmail(account updated email)\nend\n\nS--&gt;&gt;C: UserResponseDTO\nC--&gt;&gt;UI: 200 BaseResponse\nUI--&gt;&gt;A: Show updated information\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yJTFz5VBhcN5bJjHIlXc-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Accountant / HeadOfDepartment" mermaidId="n:A" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Accountant / HeadOfDepartment" id="yJTFz5VBhcN5bJjHIlXc-2">
