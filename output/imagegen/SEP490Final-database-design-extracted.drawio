        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\nautonumber\nactor U as Authorized User\nparticipant UI as AgreementStatistics.jsx\nparticipant C as DashboardController\nparticipant S as DashboardServiceImpl\nparticipant CR as ContractRepository\n\nU-&gt;&gt;UI: Open Agreement Statistics dashboard\nUI-&gt;&gt;C: GET /api/v1/dashboard/overview\nC-&gt;&gt;C: Check CEO / Administrator / Accountant / HeadOfDepartment\nC-&gt;&gt;S: getOverviewStatistics()\n\nS-&gt;&gt;CR: count()\nCR--&gt;&gt;S: Total contracts\nS-&gt;&gt;CR: countByContractStatus(ACTIVE)\nCR--&gt;&gt;S: Active contracts\nS-&gt;&gt;CR: countByContractStatus(PENDING_DIRECTOR_SIGNATURE)\nS-&gt;&gt;CR: countByContractStatus(PENDING_PARTNER_SIGNATURE)\nCR--&gt;&gt;S: Pending contracts\nS-&gt;&gt;CR: countExpiredContracts(today)\nCR--&gt;&gt;S: Expired contracts\n\nS-&gt;&gt;CR: countContractsByStatus()\nCR--&gt;&gt;S: Status chart data\nS-&gt;&gt;CR: findUpcomingExpirations(today, today + 30 days)\nCR--&gt;&gt;S: Upcoming expiration list\nS-&gt;&gt;CR: countContractsByMonth(sixMonthsAgo)\nCR--&gt;&gt;S: Monthly chart data\n\nS--&gt;&gt;C: DashboardOverviewDTO\nC--&gt;&gt;UI: 200 BaseResponse\nUI--&gt;&gt;U: Render statistics cards and charts\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="msBnStyrwxqSkZU-xI7t-1">
