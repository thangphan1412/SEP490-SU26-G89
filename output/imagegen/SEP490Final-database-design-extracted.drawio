  <diagram id="R0YsBN5gJA1OsGB69LR6" name="Class Diagram (CompanyProfileManagement)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass CompanyProfileController {\n  +getCompanyProfile()\n  +updateCompanyProfile(request)\n}\n\nclass ICompanyService {\n  +getCompanyProfile(id)\n  +updateCompanyProfile(id, request)\n}\n\nclass CompanyServiceImpl {\n  +getCompanyProfile(id)\n  +updateCompanyProfile(id, request)\n}\n\nclass CurrentUser {\n  +getCurrentUser()\n}\n\nclass CompanyRepository {\n  +findByIsInternalTrue()\n  +save(company)\n}\n\nclass EmailService {\n  +sendEmail(message)\n}\n\nclass CompanyProfileRequestDTO {\n  +companyName\n  +email\n  +registeredAddress\n}\n\nclass CompanyProfileResponseDTO {\n  +id\n  +companyName\n  +email\n  +registeredAddress\n}\n\nclass Company {\n  +id\n  +companyName\n  +email\n  +registeredAddress\n  +isInternal\n}\n\nclass Users {\n  +id\n  +email\n  +company\n}\n\nCompanyProfileController --&gt; ICompanyService\nICompanyService &lt;|.. CompanyServiceImpl\n\nCompanyServiceImpl --&gt; CurrentUser\nCompanyServiceImpl --&gt; CompanyRepository\nCompanyServiceImpl --&gt; EmailService\n\nCompanyServiceImpl ..&gt; CompanyProfileRequestDTO\nCompanyServiceImpl ..&gt; CompanyProfileResponseDTO\n\nCompanyRepository --&gt; Company\nCompanyProfileResponseDTO ..&gt; Company\nUsers --&gt; Company : company\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-rSlxr4ib6skaac50QEF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;CompanyProfileController&lt;/b&gt;" mermaidId="n:CompanyProfileController" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;CompanyProfileController&lt;/b&gt;" id="-rSlxr4ib6skaac50QEF-2">
