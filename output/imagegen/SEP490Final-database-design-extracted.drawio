  <diagram id="yfMHKbb3NmheE1dhYKhU" name="Sequence diagram — Change Password bằng mật khẩu cũ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant UI as UpdateProfile Page\n    participant API as authenService\n    participant Filter as JwtAuthenticationFilter\n    participant C as AuthenticateController\n    participant S as UserServiceImpl\n    participant CU as CurrentUser\n    participant UR as UserRepository\n    participant DB as Database\n    participant PE as PasswordEncoder\n\n    User-&gt;&gt;UI: Nhập oldPassword, newPassword, confirmPassword\n    UI-&gt;&gt;UI: Kiểm tra newPassword bằng confirmPassword\n\n    alt Hai mật khẩu mới không khớp\n        UI--&gt;&gt;User: Hiển thị lỗi tại client\n    else Client validation thành công\n        UI-&gt;&gt;API: changePassword(oldPassword, newPassword)\n        API-&gt;&gt;Filter: POST /api/v1/auth/change-password kèm JWT\n        Filter-&gt;&gt;Filter: Xác thực JWT và thiết lập SecurityContext\n        Filter-&gt;&gt;C: Forward request\n        C-&gt;&gt;C: Validate password constraints\n        C-&gt;&gt;S: changePassword(request)\n        S-&gt;&gt;CU: getCurrentUser()\n        CU-&gt;&gt;UR: findByEmail(authentication.name)\n        UR-&gt;&gt;DB: SELECT current user\n        DB--&gt;&gt;UR: Users\n        UR--&gt;&gt;CU: Users\n        CU--&gt;&gt;S: Current Users\n        S-&gt;&gt;UR: findByEmail(currentUser.email)\n        UR-&gt;&gt;DB: SELECT user BY email\n        DB--&gt;&gt;UR: Users\n        UR--&gt;&gt;S: Users\n        S-&gt;&gt;PE: matches(oldPassword, storedHash)\n\n        alt Mật khẩu cũ không đúng\n            PE--&gt;&gt;S: false\n            S--&gt;&gt;C: Old password do not match\n            C--&gt;&gt;API: Error response\n            API--&gt;&gt;UI: Error\n            UI--&gt;&gt;User: Hiển thị lỗi\n        else Mật khẩu cũ đúng\n            PE--&gt;&gt;S: true\n            S-&gt;&gt;PE: encode(newPassword)\n            PE--&gt;&gt;S: BCrypt hash\n            S-&gt;&gt;UR: save(users)\n            UR-&gt;&gt;DB: UPDATE user password\n            DB--&gt;&gt;UR: Updated user\n            S--&gt;&gt;C: void\n            C--&gt;&gt;API: 201 Created\n            API--&gt;&gt;UI: Success\n            UI--&gt;&gt;User: Thông báo đổi mật khẩu thành công\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mZqY-LgTE4IYIO3Xv0f6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
