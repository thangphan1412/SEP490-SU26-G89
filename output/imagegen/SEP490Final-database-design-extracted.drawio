  <diagram id="cJHMGPPm0HputnXx1WXA" name="Sequence diagram — Reset Password bằng OTP">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant UI as ResetPasswordForm\n    participant API as authenService\n    participant C as AuthenticateController\n    participant S as UserServiceImpl\n    participant Redis as RedisOtpService\n    participant Cache as Redis\n    participant UR as UserRepository\n    participant DB as Database\n    participant PE as PasswordEncoder\n\n    User-&gt;&gt;UI: Nhập email, OTP và mật khẩu mới\n    UI-&gt;&gt;API: reset(request)\n    API-&gt;&gt;C: POST /api/v1/auth/reset-password\n    C-&gt;&gt;C: Validate password constraints\n    C-&gt;&gt;S: resetPassword(request)\n    S-&gt;&gt;Redis: getOTP(email)\n    Redis-&gt;&gt;Cache: GET otp:email\n    Cache--&gt;&gt;Redis: OTP hoặc null\n    Redis--&gt;&gt;S: OTP hoặc null\n\n    alt OTP hết hạn hoặc không tồn tại\n        S--&gt;&gt;C: OTP is empty\n        C--&gt;&gt;API: Error response\n        API--&gt;&gt;UI: Error\n        UI--&gt;&gt;User: Hiển thị lỗi OTP\n    else OTP không khớp\n        S-&gt;&gt;S: So sánh OTP\n        S--&gt;&gt;C: Invalid OTP\n        C--&gt;&gt;API: Error response\n        API--&gt;&gt;UI: Error\n        UI--&gt;&gt;User: Hiển thị lỗi OTP\n    else OTP hợp lệ\n        S-&gt;&gt;UR: findByEmail(email)\n        UR-&gt;&gt;DB: SELECT user BY email\n        DB--&gt;&gt;UR: Users\n        UR--&gt;&gt;S: Users\n        S-&gt;&gt;S: Kiểm tra password và confirm password\n        alt Password không hợp lệ hoặc không khớp\n            S--&gt;&gt;C: Validation error\n            C--&gt;&gt;API: Error response\n            API--&gt;&gt;UI: Error\n            UI--&gt;&gt;User: Hiển thị lỗi mật khẩu\n        else Dữ liệu hợp lệ\n            S-&gt;&gt;PE: encode(newPassword)\n            PE--&gt;&gt;S: BCrypt hash\n            S-&gt;&gt;UR: save(users)\n            UR-&gt;&gt;DB: UPDATE user password\n            DB--&gt;&gt;UR: Updated user\n            S-&gt;&gt;Redis: deleteOTP(email)\n            Redis-&gt;&gt;Cache: DEL otp:email\n            Cache--&gt;&gt;Redis: OK\n            S--&gt;&gt;C: void\n            C--&gt;&gt;API: 201 Created\n            API--&gt;&gt;UI: Success\n            UI--&gt;&gt;User: Điều hướng Login\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4l7vqI6QI0gLiaa-k46b-1">
