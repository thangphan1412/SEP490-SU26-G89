        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant UI as ForgotPasswordForm\n    participant API as authenService\n    participant C as AuthenticateController\n    participant S as UserServiceImpl\n    participant UR as UserRepository\n    participant DB as Database\n    participant OTP as OTPGenerator\n    participant Redis as RedisOtpService\n    participant Cache as Redis\n    participant Mail as EmailService\n    participant SMTP as Mail Server\n\n    User-&gt;&gt;UI: Nhập email\n    UI-&gt;&gt;API: forgot(email)\n    API-&gt;&gt;C: POST /api/v1/auth/forgot-password\n    C-&gt;&gt;S: forgotPassword(email)\n    S-&gt;&gt;UR: findByEmail(email)\n    UR-&gt;&gt;DB: SELECT user BY email\n    DB--&gt;&gt;UR: User hoặc empty\n\n    alt Không tìm thấy user\n        UR--&gt;&gt;S: Optional empty\n        S--&gt;&gt;C: RuntimeException\n        C--&gt;&gt;API: Error response\n        API--&gt;&gt;UI: Error\n        UI--&gt;&gt;User: Hiển thị lỗi\n    else Tìm thấy user\n        UR--&gt;&gt;S: Users\n        S-&gt;&gt;OTP: generateOTP()\n        OTP--&gt;&gt;S: Mã OTP 6 chữ số\n        S-&gt;&gt;Redis: saveOTP(email, otp)\n        Redis-&gt;&gt;Cache: SET otp:email, TTL 6 phút\n        Cache--&gt;&gt;Redis: OK\n        S-&gt;&gt;Mail: sendEmail(email, OTP)\n        Mail-&gt;&gt;SMTP: Gửi email OTP\n        SMTP--&gt;&gt;Mail: Accepted\n        Mail--&gt;&gt;S: Success\n        S--&gt;&gt;C: void\n        C--&gt;&gt;API: 201 Created\n        API--&gt;&gt;UI: Success\n        UI--&gt;&gt;User: Điều hướng Reset Password\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rkNiPDPmH2hiXtdvur2I-1">
