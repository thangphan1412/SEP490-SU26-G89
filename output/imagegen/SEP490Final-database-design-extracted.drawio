  <diagram id="UvzCbPr_e_bAco18KtSG" name="Sequence Diagram (CompanyProfileManagement-Update Company Profile)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\nautonumber\nactor A as Accountant\nparticipant UI as Company UpdateProfile.jsx\nparticipant Sec as Spring Security\nparticipant C as CompanyProfileController\nparticipant S as CompanyServiceImpl\nparticipant CR as CompanyRepository\nparticipant ES as EmailService\n\nA-&gt;&gt;UI: Submit company profile changes\nUI-&gt;&gt;C: PUT /api/company-profile + CompanyProfileRequestDTO\nC-&gt;&gt;Sec: Check Accountant authority\nSec--&gt;&gt;C: Authorized\n\nC-&gt;&gt;S: updateCompanyProfile(null, request)\nS-&gt;&gt;CR: findByIsInternalTrue()\nCR--&gt;&gt;S: Internal Company / empty\nS-&gt;&gt;S: Set isInternal = true and update fields\nS-&gt;&gt;CR: save(company)\nCR--&gt;&gt;S: Saved Company\n\nopt Email is present\n  S-&gt;&gt;ES: sendEmail(company profile update alert)\nend\n\nS--&gt;&gt;C: CompanyProfileResponseDTO\nC--&gt;&gt;UI: 200 BaseResponse\nUI--&gt;&gt;A: Display saved company profile\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MR2l716vKurIGgqjb6VE-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
