  <diagram id="a0ZlzLYKuilGwWX-oYbl" name="Sequence diagram — Generate RSA Signing Key">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant UI as CreateSignaturePage\n    participant API as digitalSignatureService\n    participant C as SignatureController\n    participant CU as CurrentUser\n    participant S as UserKeyServiceImpl\n    participant RSA as CalculateRSA\n    participant Cert as CertificateGenerator\n    participant Crypto as Browser Web Crypto\n\n    User-&gt;&gt;UI: Nhập và xác nhận PIN\n    UI-&gt;&gt;API: generateKey()\n    API-&gt;&gt;C: POST /api/v1/signature/keys/generate\n    C-&gt;&gt;CU: getCurrentUser()\n    CU--&gt;&gt;C: Authenticated Users\n    C-&gt;&gt;S: generateUserKey(user)\n    S-&gt;&gt;RSA: generateKeyPair()\n    RSA--&gt;&gt;S: RSA parameters\n    S-&gt;&gt;S: Encode public key và PKCS8 private key\n    S-&gt;&gt;Cert: generate(publicKey, privateKey, keyCode)\n    Cert--&gt;&gt;S: X509Certificate\n    S--&gt;&gt;C: UserKeyInfoResponse\n    C--&gt;&gt;API: 200 publicKey, privateKey, keyCode, certificate\n    API--&gt;&gt;UI: Key material\n    UI-&gt;&gt;Crypto: Encrypt privateKey bằng PIN\n    Crypto--&gt;&gt;UI: AES-GCM encrypted private key\n    UI-&gt;&gt;UI: Lưu localStorage\n    UI--&gt;&gt;User: Tải encrypted private-key backup&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="u2cZ01C2RbMGV9CWM-BF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
