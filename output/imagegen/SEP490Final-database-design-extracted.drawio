  <diagram id="eG__YZoW21jiuypm4DEJ" name=" Sequence diagram — Record Signature Evidence">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    participant Caller as Contract Workflow Service\n    participant S as ContractSignatureService\n    participant ESR as ElectronicSignatureRepository\n    participant SR as SignatureRepository\n    participant DB as Database\n\n    Caller-&gt;&gt;S: recordSignature(contract, step, signer, electronicSignatureId, role, pdf, digitalSignature)\n    S-&gt;&gt;SR: existsByContractIdAndWorkflowStepInstanceId(contractId, stepId)\n    SR-&gt;&gt;DB: Kiểm tra bước đã ký\n    DB--&gt;&gt;SR: exists\n\n    alt Bước đã được ký\n        SR--&gt;&gt;S: true\n        S--&gt;&gt;Caller: This workflow step has already been signed\n    else Chưa ký\n        SR--&gt;&gt;S: false\n        S-&gt;&gt;ESR: findByIdAndUserIdAndStatus(id, signerId, ACTIVE)\n        ESR-&gt;&gt;DB: SELECT active electronic signature thuộc signer\n        DB--&gt;&gt;ESR: ElectronicSignatures hoặc empty\n        alt Mẫu chữ ký không hợp lệ\n            ESR--&gt;&gt;S: Optional empty\n            S--&gt;&gt;Caller: Signature unavailable or not owned\n        else Mẫu chữ ký hợp lệ\n            ESR--&gt;&gt;S: ElectronicSignatures và UserKeys\n            S-&gt;&gt;S: Tính SHA-256 PDF\n            S-&gt;&gt;S: Verify digitalSignature bằng public key\n            alt Digital signature không hợp lệ\n                S--&gt;&gt;Caller: Private key does not match\n            else Digital signature hợp lệ\n                S-&gt;&gt;SR: save(Signature status SIGNED)\n                SR-&gt;&gt;DB: INSERT signature evidence\n                DB--&gt;&gt;SR: Saved Signature\n                SR--&gt;&gt;S: Signature\n                S--&gt;&gt;Caller: Signature\n            end\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NqxXor5rR_d5fSSdPfwn-1">
