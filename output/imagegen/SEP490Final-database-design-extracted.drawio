  <diagram id="qtVFURseSmWyIqXF4ks4" name="Sequence diagram — Create Electronic Signature">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant UI as CreateSignaturePage\n    participant Crypto as Browser Web Crypto\n    participant KeyAPI as digitalSignatureService\n    participant SC as SignatureController\n    participant UKS as UserKeyServiceImpl\n    participant RSA as CalculateRSA\n    participant ESAPI as electronicSignatureService\n    participant ESC as ElectronicSignatureController\n    participant ESS as ElectronicSignatureServiceImpl\n    participant CU as CurrentUser\n    participant UKR as UserKeysRepository\n    participant Cloud as CloudinaryService\n    participant ESR as ElectronicSignatureRepository\n    participant DB as Database\n\n    User-&gt;&gt;UI: Nhập PIN và yêu cầu tạo RSA key\n    UI-&gt;&gt;KeyAPI: generateKey()\n    KeyAPI-&gt;&gt;SC: POST /api/v1/signature/keys/generate\n    SC-&gt;&gt;CU: getCurrentUser()\n    CU--&gt;&gt;SC: Authenticated Users\n    SC-&gt;&gt;UKS: generateUserKey(user)\n    UKS-&gt;&gt;RSA: generateKeyPair()\n    RSA--&gt;&gt;UKS: RSA key pair\n    UKS-&gt;&gt;UKS: Encode public/private key và tạo certificate\n    UKS--&gt;&gt;SC: UserKeyInfoResponse\n    SC--&gt;&gt;KeyAPI: 200 publicKey, privateKey, keyCode, certificate\n    KeyAPI--&gt;&gt;UI: Key data\n    UI-&gt;&gt;Crypto: PBKDF2 PIN và AES-GCM encrypt privateKey\n    Crypto--&gt;&gt;UI: Encrypted private key\n    UI-&gt;&gt;UI: Lưu encrypted key vào localStorage\n    UI--&gt;&gt;User: Tải file backup private-key.enc\n\n    User-&gt;&gt;UI: Vẽ hoặc upload ảnh rồi Save\n    UI-&gt;&gt;UI: Tạo multipart FormData\n    UI-&gt;&gt;ESAPI: createElectronicSignature(formData)\n    ESAPI-&gt;&gt;ESC: POST /api/v1/create/electronic-signatures\n    ESC-&gt;&gt;ESC: Đưa multipartFile vào CreateFileStorageRequest\n    ESC-&gt;&gt;ESS: createElectronicSignature(request)\n    ESS-&gt;&gt;CU: getCurrentUser()\n    CU--&gt;&gt;ESS: Authenticated Users\n    ESS-&gt;&gt;UKS: saveUserKey(user, publicKey, keyCode, certificate)\n    UKS-&gt;&gt;UKR: save(UserKeys)\n    UKR-&gt;&gt;DB: INSERT user key\n    DB--&gt;&gt;UKR: Saved key\n    UKR--&gt;&gt;UKS: UserKeys\n    UKS--&gt;&gt;ESS: void\n    ESS-&gt;&gt;Cloud: uploadAndSave(signatureImage, user)\n    Cloud-&gt;&gt;DB: INSERT FileStorage metadata\n    Cloud--&gt;&gt;ESS: FileStorage\n    ESS-&gt;&gt;ESR: save(ElectronicSignatures)\n    ESR-&gt;&gt;DB: INSERT electronic_signature\n    DB--&gt;&gt;ESR: Saved ElectronicSignatures\n    ESR--&gt;&gt;ESS: ElectronicSignatures\n    ESS--&gt;&gt;ESC: ElectronicSignatures\n    ESC--&gt;&gt;ESAPI: 201 Created\n    ESAPI--&gt;&gt;UI: Success\n    UI--&gt;&gt;User: Hiển thị tạo chữ ký thành công&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lfgFIyLIuamYuaJDzxyz-1">
