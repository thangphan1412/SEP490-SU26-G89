  <diagram id="SOYXKqNIOIZQHgi3EJ1D" name="Sequence Diagram (UserProfileManagement-Update User Profile)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\nautonumber\nactor U as User\nparticipant UI as UpdateProfile.jsx\nparticipant C as UserProfileController\nparticipant CU as CurrentUser\nparticipant S as UserServiceImpl\nparticipant UR as UserRepository\nparticipant ES as EmailService\n\nU-&gt;&gt;UI: Submit personal information\nUI-&gt;&gt;C: PUT /api/profile + UserProfileRequestDTO\nC-&gt;&gt;CU: getCurrentUser()\nCU--&gt;&gt;C: Current Users\n\nC-&gt;&gt;S: updateMyProfile(currentUser.id, request)\nS-&gt;&gt;UR: findById(userId)\nUR--&gt;&gt;S: Users\n\nopt Email is changed\n  S-&gt;&gt;UR: existsByEmail(newEmail)\n  UR--&gt;&gt;S: false\nend\n\nS-&gt;&gt;UR: save(updated Users)\nUR--&gt;&gt;S: Saved Users\nS-&gt;&gt;ES: sendEmail(profile update alert)\nES--&gt;&gt;S: Sent / ignored failure\n\nS--&gt;&gt;C: UserProfileResponseDTO\nC--&gt;&gt;UI: 200 BaseResponse\nUI--&gt;&gt;U: Show success message\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6w_zWPFfBxGonxomN74A-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
