  <diagram id="TpBHA47tTzQFwdn1hcis" name="classDiagramSignatureController">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class SignatureController {\n        &lt;&lt;RestController&gt;&gt;\n        -CurrentUser currentUser\n        -UserKeysRepository userKeysRepository\n        -SignatureRepository signatureRepository\n        -DigitalSignatureVerificationService verificationService\n        -CloudinaryService cloudinaryService\n        -UserKeyServiceImpl userKeyService\n        -PadesVerificationService padesVerificationService\n        -ContractRepository contractRepository\n        +getMyPublicKey() ResponseEntity\n        +generateKey() ResponseEntity\n        +verify(UUID signatureId, MultipartFile file) ResponseEntity\n        +verifyStoredPdf(UUID signatureId) ResponseEntity\n        +verifySignatures(UUID contractId, MultipartFile file) ResponseEntity\n        -toResponse(UserKeys key) UserKeyInfoResponse\n    }\n\n    class PadesController {\n        &lt;&lt;RestController&gt;&gt;\n        -PadesSigningService padesSigningService\n        -ContractRepository contractRepository\n        -CurrentUser currentUser\n        +prepareSigning(UUID contractId, UUID electronicSignatureId, String keyCode, int pageNumber, float x, float y, float width, float height, MultipartFile file) ResponseEntity\n        +completeSigning(UUID contractId, PadesCompleteRequest request) ResponseEntity\n    }\n\n    class IUserKeyService {\n        &lt;&lt;Interface&gt;&gt;\n        +generateUserKey(Users user) UserKeyInfoResponse\n    }\n\n    class UserKeyServiceImpl {\n        &lt;&lt;Service&gt;&gt;\n        -UserKeysRepository userKeysRepository\n        -CalculateRSA calculateRSA\n        +generateUserKey(Users user) UserKeyInfoResponse\n        +saveUserKey(Users user, String publicKey, String keyCode, String certificate) void\n        +changToPingPrivateKey(String key) String\n        +encodePublicKey(BigInteger modulus, BigInteger exponent) String\n    }\n\n    class PadesSigningService {\n        &lt;&lt;Service&gt;&gt;\n        -UserKeysRepository userKeysRepository\n        -CloudinaryService cloudinaryService\n        -ContractRepository contractRepository\n        -CurrentUser currentUser\n        -PadesVerificationService padesVerificationService\n        -ElectronicSignatureRepository electronicSignatureRepository\n        -Map~UUID,PadesSigningSession~ sessions\n        +prepare(UUID contractId, UUID userId, UUID electronicSignatureId, String keyCode, int page, float x, float y, float width, float height, byte[] pdf) PadesPrepareResponse\n        +complete(UUID sessionId, String signatureValue) byte[]\n        +getSession(UUID sessionId) PadesSigningSession\n        -verifyBrowserSignature(byte[] content, byte[] signature, X509Certificate certificate) boolean\n        -drawSignatureImage(PDDocument document, UUID electronicSignatureId, int page, float x, float y, float width, float height) void\n    }\n\n    class ContractSignatureService {\n        &lt;&lt;Service&gt;&gt;\n        -SignatureRepository signatureRepository\n        -ElectronicSignatureRepository electronicSignatureRepository\n        +recordSignature(Contracts contract, ContractWorkflowStepInstance step, Users signer, UUID electronicSignatureId, String signerRole, byte[] pdf, String digitalSignature) Signature\n        +calculatePdfHash(byte[] pdfContent) String\n        +validatePublicKey(String publicKeyPem) RegisteredPublicKey\n        -verifyDigitalSignature(byte[] pdf, String publicKey, String signature) VerifiedDigitalSignature\n    }\n\n    class DigitalSignatureVerificationService {\n        &lt;&lt;Service&gt;&gt;\n        -UserKeysRepository userKeysRepository\n        +verify(byte[] document, String signatureValue, UUID userId, String keyCode) boolean\n    }\n\n    class PadesVerificationService {\n        &lt;&lt;Service&gt;&gt;\n        +verifyAll(byte[] pdfBytes) List~PadesVerificationResult~\n        -verifySingleSignature(byte[] pdfBytes, PDSignature signature, int index) PadesVerificationResult\n        -extractCmsSignature(byte[] contents) byte[]\n    }\n\n    class SignatureRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +findById(UUID id) Optional~Signature~\n        +save(Signature signature) Signature\n        +findByContractIdOrderBySignedAtAsc(UUID contractId) List~Signature~\n        +existsByContractIdAndWorkflowStepInstanceId(UUID contractId, UUID stepId) boolean\n        +existsByContractId(UUID contractId) boolean\n    }\n\n    class UserKeysRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +findByUserId(UUID userId) Optional~UserKeys~\n        +findByUserIdAndKeyCode(UUID userId, String keyCode) Optional~UserKeys~\n        +existsAllByKeyStatus(UUID userId, KeyStatus status) boolean\n        +save(UserKeys key) UserKeys\n    }\n\n    class ElectronicSignatureRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +findById(UUID id) Optional~ElectronicSignatures~\n        +findByIdAndUserIdAndStatus(UUID id, UUID userId, ElectronicStatus status) Optional~ElectronicSignatures~\n    }\n\n    class ContractRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +findById(UUID id) Optional~Contracts~\n        +save(Contracts contract) Contracts\n    }\n\n    class CloudinaryService {\n        &lt;&lt;Service&gt;&gt;\n        +download(FileStorage file) byte[]\n        +uploadPdfAndSave(byte[] pdf, String name, Users user) FileStorage\n    }\n\n    class CurrentUser {\n        &lt;&lt;Service&gt;&gt;\n        +getCurrentUser() Users\n    }\n\n    class UserKeyInfoResponse {\n        &lt;&lt;ResponseDTO&gt;&gt;\n        +boolean available\n        +String publicKey\n        +String algorithm\n        +String keyCode\n        +long keySize\n        +LocalDateTime createdAt\n        +String privateKey\n        +String certificate\n    }\n\n    class SignatureVerificationResponse {\n        &lt;&lt;ResponseDTO&gt;&gt;\n        +UUID signatureId\n        +UUID contractId\n        +UUID signerId\n        +String documentHash\n        +boolean valid\n    }\n\n    class PadesPrepareResponse {\n        &lt;&lt;ResponseDTO&gt;&gt;\n        +UUID sessionId\n        +String documentHash\n        +String contentToSign\n        +String hashAlgorithm\n        +String signatureAlgorithm\n        +String keyCode\n    }\n\n    class PadesCompleteRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        +UUID sessionId\n        +String signatureValue\n    }\n\n    class PadesSigningSession {\n        &lt;&lt;SessionDTO&gt;&gt;\n        -UUID sessionId\n        -UUID contractId\n        -UUID userId\n        -UUID electronicSignatureId\n        -String keyCode\n        -byte[] originalPdf\n        -byte[] preparedPdf\n        -byte[] contentToSign\n        -String documentHash\n        -int signatureOffset\n        -int signatureCapacity\n        -int pageNumber\n        -float positionX\n        -float positionY\n        -float signatureWidth\n        -float signatureHeight\n    }\n\n    class PadesVerificationResult {\n        &lt;&lt;ResponseRecord&gt;&gt;\n        +int signatureIndex\n        +boolean valid\n        +String signerSubject\n        +String publicKeyAlgorithm\n        +String certificateSerialNumber\n        +Date certificateNotBefore\n        +Date certificateNotAfter\n        +boolean certificateValid\n        +String message\n    }\n\n    class Signature {\n        &lt;&lt;Entity&gt;&gt;\n        -String signatureName\n        -SignatureType signatureType\n        -String documentHash\n        -String signingPublicKey\n        -String digitalSignature\n        -String publicKeyFingerprint\n        -String signatureValue\n        -SignatureAlgorithm signatureAlgorithm\n        -SignatureHash signatureHash\n        -String certificateSerial\n        -SignatureStatus status\n        -LocalDate signatureUpdateAt\n        -LocalDateTime signatureCreateAt\n        -LocalDateTime signedAt\n        -String signerRole\n        -Integer pageNumber\n        -Float positionX\n        -Float positionY\n        -Float signatureWidth\n        -Float signatureHeight\n        -UserKeys userKey\n        -Contracts contract\n        -Users signedBy\n        -ContractWorkflowStepInstance workflowStepInstance\n        -ElectronicSignatures electronicSignatures\n        -FileStorage fileStorage\n    }\n\n    class UserKeys {\n        &lt;&lt;Entity&gt;&gt;\n        -long keySize\n        -LocalDateTime createAt\n        -String publicKey\n        -String keyFingerprint\n        -String keyCode\n        -KeyAlgorithm keyAlgorithm\n        -KeyStatus keyStatus\n        -String certificate\n        -Users user\n        -List~Signature~ signatures\n    }\n\n    class ElectronicSignatures {\n        &lt;&lt;Entity&gt;&gt;\n        -String electronicSignatureName\n        -ElectronicStatus status\n        -FileStorage fileStorage\n        -Users user\n        -UserKeys userKey\n    }\n\n    class Contracts {\n        &lt;&lt;Entity&gt;&gt;\n        -String contractNumber\n        -String documentHash\n        -FileStorage documentFile\n    }\n\n    class Users {\n        &lt;&lt;Entity&gt;&gt;\n        -String email\n    }\n\n    class FileStorage {\n        &lt;&lt;Entity&gt;&gt;\n        -String filePath\n        -String originalName\n    }\n\n    UserKeyServiceImpl ..|&gt; IUserKeyService : realizes\n    SignatureController ..&gt; UserKeyServiceImpl : generates key\n    SignatureController ..&gt; SignatureRepository : loads signature\n    SignatureController ..&gt; DigitalSignatureVerificationService : verifies RSA\n    SignatureController ..&gt; PadesVerificationService : verifies PAdES\n    SignatureController ..&gt; CloudinaryService : downloads stored PDF\n    PadesController ..&gt; PadesSigningService : prepares and completes\n    PadesController ..&gt; ContractRepository : validates contract\n    PadesSigningService ..&gt; UserKeysRepository : loads signing key\n    PadesSigningService ..&gt; ElectronicSignatureRepository : loads signature image\n    PadesSigningService ..&gt; PadesVerificationService : protects existing signatures\n    PadesSigningService ..&gt; CloudinaryService : stores signed PDF\n    PadesSigningService ..&gt; ContractRepository : updates contract\n    ContractSignatureService ..&gt; SignatureRepository : persists evidence\n    ContractSignatureService ..&gt; ElectronicSignatureRepository : validates selected template\n    DigitalSignatureVerificationService ..&gt; UserKeysRepository : loads public key\n    Signature --|&gt; BaseEntity : extends\n    UserKeys --|&gt; BaseEntity : extends\n    Signature \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Contracts : belongs to\n    Signature \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Users : signed by\n    Signature \&quot;0..*\&quot; --&gt; \&quot;1\&quot; UserKeys : verified with\n    Signature \&quot;0..*\&quot; --&gt; \&quot;1\&quot; ElectronicSignatures : uses template\n    Signature \&quot;0..*\&quot; --&gt; \&quot;1\&quot; FileStorage : references\n    UserKeys \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Users : belongs to\n    ElectronicSignatures \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Users : belongs to&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RP0WblVx1RofANJBwLkt-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
