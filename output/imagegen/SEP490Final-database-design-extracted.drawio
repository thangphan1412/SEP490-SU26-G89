  <diagram name="Class Diagram (Dashboard &amp; Statistics-Pending Signature Agreements)" id="dUHG9qjR_2Hwxc2tCpTj">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="ZQSD9BOJ0nCJjzKFX1Al-0" />
        <mxCell id="ZQSD9BOJ0nCJjzKFX1Al-1" parent="ZQSD9BOJ0nCJjzKFX1Al-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass DashboardController {\n  +getOverview()\n  +getStatisticalReports()\n  +getPendingSignatures()\n}\n\nclass IDashboardService {\n  +getOverviewStatistics()\n  +getStatisticalReports()\n  +getPendingSignatureDashboard()\n}\n\nclass DashboardServiceImpl {\n  +getOverviewStatistics()\n  +getStatisticalReports()\n  +getPendingSignatureDashboard()\n}\n\nclass ContractController {\n  +getContracts(search, status, page, sortBy, sortDirection)\n}\n\nclass ContractService {\n  +getContracts(request)\n}\n\nclass ContractServiceImpl {\n  +getContracts(request)\n}\n\nclass CurrentUser {\n  +getCurrentUser()\n}\n\nclass IPermissionAccessService {\n  +getCurrentUserProjectIdsWithAction(action)\n}\n\nclass ContractRepository {\n  +count()\n  +countByContractStatus(status)\n  +countContractsByStatus()\n  +findUpcomingExpirations(...)\n  +countContractsByMonth(date)\n  +countContractsByType()\n  +getPendingSignatureDetails()\n  +searchAccessibleContracts(...)\n}\n\nclass ContractWorkflowStepInstanceRepository {\n  +findDistinctProjectIdsByAssignedUserId(userId)\n}\n\nclass DashboardOverviewDTO {\n  +totalContracts\n  +activeContracts\n  +pendingContracts\n  +expiredContracts\n}\n\nclass DashboardStatsDTO {\n  +totalContracts\n  +contractsByType\n  +pendingSignatureDetails\n}\n\nclass ContractListRequest {\n  +search\n  +status\n  +page\n  +sortBy\n  +sortDirection\n}\n\nclass ContractListResponse {\n  +contracts\n  +page\n  +totalElements\n  +availableStatuses\n}\n\nclass Contracts {\n  +id\n  +contractStatus\n  +contractCreatedAt\n  +expirationDate\n}\n\nclass Users {\n  +id\n  +email\n}\n\nclass ContractStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  ACTIVE\n  PENDING_DIRECTOR_SIGNATURE\n  PENDING_PARTNER_SIGNATURE\n  CANCELLED\n  ENDED\n}\n\nDashboardController --&gt; DashboardServiceImpl\nIDashboardService &lt;|.. DashboardServiceImpl\nDashboardServiceImpl --&gt; ContractRepository\nDashboardServiceImpl ..&gt; DashboardOverviewDTO\nDashboardServiceImpl ..&gt; DashboardStatsDTO\n\nContractController --&gt; ContractService\nContractService &lt;|.. ContractServiceImpl\nContractServiceImpl --&gt; CurrentUser\nContractServiceImpl --&gt; IPermissionAccessService\nContractServiceImpl --&gt; ContractWorkflowStepInstanceRepository\nContractServiceImpl --&gt; ContractRepository\nContractServiceImpl ..&gt; ContractListRequest\nContractServiceImpl ..&gt; ContractListResponse\n\nCurrentUser --&gt; Users\nContractRepository --&gt; Contracts\nContractWorkflowStepInstanceRepository --&gt; Contracts\nContracts --&gt; ContractStatus\n\nclassDef used fill:#FFFFFF,stroke:#333333,color:#D32F2F;\n\nclass DashboardController:::used\nclass DashboardServiceImpl:::used\nclass ContractRepository:::used\nclass DashboardStatsDTO:::used\nclass ContractController:::used\nclass ContractService:::used\nclass ContractServiceImpl:::used\nclass CurrentUser:::used\nclass IPermissionAccessService:::used\nclass ContractWorkflowStepInstanceRepository:::used\nclass ContractListRequest:::used\nclass ContractListResponse:::used\nclass Contracts:::used\nclass Users:::used\nclass ContractStatus:::used&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Any5yjE_fAtbmCS7Lend-0">
          <mxCell connectable="0" parent="ZQSD9BOJ0nCJjzKFX1Al-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
