  <diagram id="XPlKI76KQfjRIWF9AAzp" name="Sequence Diagram (Dashboard-Pending Signature Agreements)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\nautonumber\nactor U as Authorized User\nparticipant UI as PendingSignatureAgreements.jsx\nparticipant DC as DashboardController\nparticipant DS as DashboardServiceImpl\nparticipant CC as ContractController\nparticipant CS as ContractServiceImpl\nparticipant CU as CurrentUser\nparticipant PA as IPermissionAccessService\nparticipant WR as ContractWorkflowStepInstanceRepository\nparticipant CR as ContractRepository\n\nU-&gt;&gt;UI: Open Pending Signature dashboard\n\npar Dashboard counters and chart\n  UI-&gt;&gt;DC: GET /api/v1/dashboard/pending-signatures\n  DC-&gt;&gt;DC: Check allowed authority\n  DC-&gt;&gt;DS: getPendingSignatureDashboard()\n  DS-&gt;&gt;CR: getPendingSignatureDetails()\n  CR--&gt;&gt;DS: Pending contract details\n  DS-&gt;&gt;CR: countByContractStatus(...)\n  CR--&gt;&gt;DS: Pending status counts\n  DS--&gt;&gt;DC: DashboardStatsDTO\n  DC--&gt;&gt;UI: 200 BaseResponse\nand Paginated contract table\n  UI-&gt;&gt;CC: GET /api/v1/contracts/list?status=PENDING_SIGNATURE\n  CC-&gt;&gt;CS: getContracts(ContractListRequest)\n  CS-&gt;&gt;CU: getCurrentUser()\n  CU--&gt;&gt;CS: Current Users\n  CS-&gt;&gt;PA: getCurrentUserProjectIdsWithAction(VIEW)\n  PA--&gt;&gt;CS: Permission project IDs\n  CS-&gt;&gt;WR: findDistinctProjectIdsByAssignedUserId(user.id)\n  WR--&gt;&gt;CS: Workflow project IDs\n  CS-&gt;&gt;CR: searchAccessibleContracts(...)\n  CR--&gt;&gt;CS: Page of Contracts\n  CS--&gt;&gt;CC: ContractListResponse\n  CC--&gt;&gt;UI: 200 BaseResponse\nend\n\nUI--&gt;&gt;U: Render pending chart and contract table\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dW1HeRpsoQ8zD6Fi1X-e-1">
