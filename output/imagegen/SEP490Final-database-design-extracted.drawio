        <mxCell id="vreDW9uliCKldbI5T2nb-1" parent="vreDW9uliCKldbI5T2nb-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass CompanyProfileController {\n  +getCompanyProfile()\n  +updateCompanyProfile(request)\n}\n\nclass ICompanyService {\n  +getCompanyProfile(id)\n  +updateCompanyProfile(id, request)\n}\n\nclass CompanyServiceImpl {\n  +getCompanyProfile(id)\n  +updateCompanyProfile(id, request)\n}\n\nclass CurrentUser {\n  +getCurrentUser()\n}\n\nclass CompanyRepository {\n  +findByIsInternalTrue()\n  +save(company)\n}\n\nclass EmailService {\n  +sendEmail(message)\n}\n\nclass CompanyProfileRequestDTO {\n  +companyName\n  +email\n  +registeredAddress\n}\n\nclass CompanyProfileResponseDTO {\n  +id\n  +companyName\n  +email\n  +registeredAddress\n}\n\nclass Company {\n  +id\n  +companyName\n  +email\n  +registeredAddress\n  +isInternal\n}\n\nclass Users {\n  +id\n  +email\n  +company\n}\n\nCompanyProfileController --&gt; ICompanyService\nICompanyService &lt;|.. CompanyServiceImpl\n\nCompanyServiceImpl --&gt; CurrentUser\nCompanyServiceImpl --&gt; CompanyRepository\nCompanyServiceImpl --&gt; EmailService\n\nCompanyServiceImpl ..&gt; CompanyProfileRequestDTO\nCompanyServiceImpl ..&gt; CompanyProfileResponseDTO\n\nCompanyRepository --&gt; Company\nCompanyProfileResponseDTO ..&gt; Company\nUsers --&gt; Company : company\n\nclassDef used fill:#FFFFFF,stroke:#333333,color:#D32F2F;\n\nclass CompanyProfileController:::used\nclass ICompanyService:::used\nclass CompanyServiceImpl:::used\nclass CompanyRepository:::used\nclass EmailService:::used\nclass CompanyProfileRequestDTO:::used\nclass CompanyProfileResponseDTO:::used\nclass Company:::used&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Lf8NK0qFGqScPQJi_-yP-0">
