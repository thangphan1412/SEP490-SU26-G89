  <diagram name="Class Diagram (UserProfileManagement-Update User Profile)" id="sla83MP2qHQsG5SBnMb5">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="5Y52A4sMm-zwYCjgwb6z-0" />
        <mxCell id="5Y52A4sMm-zwYCjgwb6z-1" parent="5Y52A4sMm-zwYCjgwb6z-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass UserProfileController {\n  +getMyProfile()\n  +updateMyProfile(request)\n}\n\nclass AuthenticateController {\n  +forgotPassword(request)\n  +resetPassword(request)\n  +changePassword(request)\n}\n\nclass IUserService {\n  +getMyProfile(userId)\n  +updateMyProfile(userId, request)\n}\n\nclass UserServiceImpl {\n  +getMyProfile(userId)\n  +updateMyProfile(userId, request)\n  +forgotPassword(request)\n  +resetPassword(request)\n  +changePassword(request)\n}\n\nclass CurrentUser {\n  +getCurrentUser()\n}\n\nclass UserRepository {\n  +findById(id)\n  +findByEmail(email)\n  +existsByEmail(email)\n  +save(user)\n}\n\nclass PasswordEncoder {\n  +matches(raw, encoded)\n  +encode(password)\n}\n\nclass OTPGenerator {\n  +generateOTP()\n}\n\nclass RedisOtpService {\n  +saveOTP(email, otp)\n  +getOTP(email)\n  +deleteOTP(email)\n}\n\nclass EmailService {\n  +sendEmail(message)\n}\n\nclass UserProfileRequestDTO {\n  +firstName\n  +lastName\n  +email\n  +numberPhone\n}\n\nclass UserProfileResponseDTO {\n  +id\n  +firstName\n  +lastName\n  +email\n  +role\n  +departmentName\n}\n\nclass ForgotPasswordRequest {\n  +email\n}\n\nclass ResetPasswordRequest {\n  +email\n  +otp\n  +newPassword\n  +newPasswordConfirm\n}\n\nclass ChangePasswordRequest {\n  +oldPassword\n  +newPassword\n}\n\nclass Users {\n  +id\n  +email\n  +password\n  +firstName\n  +lastName\n  +numberPhone\n  +status\n}\n\nclass Departments {\n  +departmentName\n}\n\nclass Role {\n  +roleName\n}\n\nclass UserRole {\n  +user\n  +role\n}\n\nclass UserStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  ACTIVE\n  INACTIVE\n}\n\nUserProfileController --&gt; IUserService\nUserProfileController --&gt; CurrentUser\nAuthenticateController --&gt; UserServiceImpl\nIUserService &lt;|.. UserServiceImpl\n\nUserServiceImpl --&gt; CurrentUser\nUserServiceImpl --&gt; UserRepository\nUserServiceImpl --&gt; PasswordEncoder\nUserServiceImpl --&gt; OTPGenerator\nUserServiceImpl --&gt; RedisOtpService\nUserServiceImpl --&gt; EmailService\n\nUserServiceImpl ..&gt; UserProfileRequestDTO\nUserServiceImpl ..&gt; UserProfileResponseDTO\nUserServiceImpl ..&gt; ForgotPasswordRequest\nUserServiceImpl ..&gt; ResetPasswordRequest\nUserServiceImpl ..&gt; ChangePasswordRequest\n\nUserRepository --&gt; Users\nUserProfileResponseDTO ..&gt; Users\nUsers --&gt; Departments : department\nUsers --&gt; UserRole : userRoles\nUserRole --&gt; Role : role\nUsers --&gt; UserStatus : status\n\nclassDef used fill:#FFFFFF,stroke:#333333,color:#D32F2F;\n\nclass UserProfileController:::used\nclass IUserService:::used\nclass UserServiceImpl:::used\nclass CurrentUser:::used\nclass UserRepository:::used\nclass EmailService:::used\nclass UserProfileRequestDTO:::used\nclass UserProfileResponseDTO:::used\nclass Users:::used\nclass Departments:::used\nclass Role:::used\nclass UserRole:::used\nclass UserStatus:::used&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IZL4A4VxvSUBTEqTIyo6-0">
          <mxCell connectable="0" parent="5Y52A4sMm-zwYCjgwb6z-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
