  <diagram id="FfRg2a1UuEn6obQhWRbb" name="Sequence Diagram (UserManagement-Create User)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\nautonumber\nactor A as Accountant / HeadOfDepartment\nparticipant UI as CreateUser.jsx\nparticipant Sec as Spring Security\nparticipant C as UserController\nparticipant S as UserServiceImpl\nparticipant CU as CurrentUser\nparticipant UR as UserRepository\nparticipant DR as DepartmentRepository\nparticipant RR as RoleRepository\nparticipant URR as UserRoleRepository\nparticipant CR as CompanyRepository\nparticipant PE as PasswordEncoder\nparticipant KS as UserKeyServiceImpl\nparticipant ES as EmailService\n\nA-&gt;&gt;UI: Submit create-user form\nUI-&gt;&gt;C: POST /api/users + UserCreateRequestDTO\nC-&gt;&gt;Sec: Check Accountant or HeadOfDepartment\nSec--&gt;&gt;C: Authorized\nC-&gt;&gt;S: createUser(request)\n\nS-&gt;&gt;UR: existsByEmail(email)\nUR--&gt;&gt;S: false\n\nS-&gt;&gt;CU: getCurrentUser()\nCU--&gt;&gt;S: Creator user\nS-&gt;&gt;S: Validate creator role and target role\n\nS-&gt;&gt;DR: findByDepartmentName(departmentName)\nDR--&gt;&gt;S: Departments\nS-&gt;&gt;PE: encode(password)\n\nalt Role is External Parners\n  S-&gt;&gt;CR: save(external company)\n  CR--&gt;&gt;S: Company\nelse Internal company\n  S-&gt;&gt;CR: findByIsInternalTrue()\n  CR--&gt;&gt;S: Internal Company / empty\n  opt Internal company does not exist\n    S-&gt;&gt;CR: save(new internal company)\n    CR--&gt;&gt;S: Company\n  end\nend\n\nS-&gt;&gt;UR: save(new Users)\nUR--&gt;&gt;S: Saved Users\nS-&gt;&gt;RR: findByRoleName(role)\nRR--&gt;&gt;S: Role\nS-&gt;&gt;URR: save(new UserRole)\n\nopt Role can receive signing permission\n  S-&gt;&gt;KS: generateUserKey(savedUser)\n  KS--&gt;&gt;S: UserKeys created\nend\n\nopt sendWelcomeEmail = true\n  S-&gt;&gt;ES: sendEmail(welcome email)\nend\n\nS--&gt;&gt;C: UserResponseDTO\nC--&gt;&gt;UI: 201 BaseResponse\nUI--&gt;&gt;A: Show success message\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kXGGT15myP3Rcaj5ME7N-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Accountant / HeadOfDepartment" mermaidId="n:A" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Accountant / HeadOfDepartment" id="kXGGT15myP3Rcaj5ME7N-2">
