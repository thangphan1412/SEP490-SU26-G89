  <diagram id="oT_6XTaRK-ULCx9xmmbD" name="Sequence diagram — Update Electronic Signature">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant UI as UpdateSignature\n    participant Crypto as Browser Web Crypto\n    participant API as electronicSignatureService\n    participant C as ElectronicSignatureController\n    participant S as ElectronicSignatureServiceImpl\n    participant CU as CurrentUser\n    participant R as ElectronicSignatureRepository\n    participant KeyValidator as ContractSignatureService\n    participant UKR as UserKeyRepository\n    participant Cloud as CloudinaryService\n    participant DB as Database\n\n    User-&gt;&gt;UI: Mở trang cập nhật\n    UI-&gt;&gt;API: getElectronicSignatureById(id)\n    API-&gt;&gt;C: GET /api/v1/electronic-by/{id}\n    C--&gt;&gt;UI: Existing signature data\n\n    opt Chữ ký cũ chưa có public key\n        UI-&gt;&gt;Crypto: Generate RSA signing keys\n        Crypto--&gt;&gt;UI: publicKey và privateKey\n        UI--&gt;&gt;User: Chuẩn bị tải private key\n    end\n\n    User-&gt;&gt;UI: Thay đổi thông tin hoặc ảnh\n    UI-&gt;&gt;API: updateElectronicSignature(id, formData)\n    API-&gt;&gt;C: PUT /api/v1/update/electronic-by/{id}\n    C-&gt;&gt;S: updateElectronicSignature(id, request, file)\n    S-&gt;&gt;CU: getCurrentUser()\n    CU--&gt;&gt;S: Authenticated Users\n    S-&gt;&gt;R: findById(id)\n    R-&gt;&gt;DB: SELECT electronic_signature BY id\n    DB--&gt;&gt;R: ElectronicSignatures hoặc empty\n\n    alt Không tìm thấy\n        R--&gt;&gt;S: Optional empty\n        S--&gt;&gt;C: Electronic signature not found\n        C--&gt;&gt;API: Error response\n        API--&gt;&gt;UI: Error\n        UI--&gt;&gt;User: Hiển thị lỗi\n    else Không thuộc current user\n        R--&gt;&gt;S: ElectronicSignatures\n        S-&gt;&gt;S: So sánh signature.user.id với currentUser.id\n        S--&gt;&gt;C: Permission denied\n        C--&gt;&gt;API: Error response\n        API--&gt;&gt;UI: Error\n        UI--&gt;&gt;User: Hiển thị không có quyền\n    else Đúng chủ sở hữu\n        R--&gt;&gt;S: ElectronicSignatures\n        opt Request có publicKey mới cho legacy signature\n            S-&gt;&gt;KeyValidator: validatePublicKey(publicKey)\n            KeyValidator--&gt;&gt;S: RegisteredPublicKey\n            alt Đã có key nhưng fingerprint khác\n                S--&gt;&gt;C: RSA key cannot be replaced\n                C--&gt;&gt;API: Error response\n                API--&gt;&gt;UI: Error\n                UI--&gt;&gt;User: Hiển thị lỗi khóa bất biến\n            else Chưa có key\n                S-&gt;&gt;UKR: save(UserKeys)\n                UKR-&gt;&gt;DB: INSERT user key\n                DB--&gt;&gt;UKR: Saved key\n                UKR--&gt;&gt;S: UserKeys\n            end\n        end\n        opt Có ảnh mới\n            S-&gt;&gt;Cloud: uploadAndSave(file, user)\n            Cloud-&gt;&gt;DB: INSERT FileStorage metadata\n            DB--&gt;&gt;Cloud: Saved file\n            Cloud--&gt;&gt;S: New FileStorage\n        end\n        S-&gt;&gt;S: Cập nhật name, type, status, default, updatedAt\n        S-&gt;&gt;R: save(signature)\n        R-&gt;&gt;DB: UPDATE electronic_signature\n        DB--&gt;&gt;R: Updated signature\n        R--&gt;&gt;S: ElectronicSignatures\n        S--&gt;&gt;C: ElectronicSignatures\n        C--&gt;&gt;API: 200 OK\n        API--&gt;&gt;UI: Success\n        UI--&gt;&gt;User: Hiển thị cập nhật thành công\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fFUnYYiy8us-99wB4B5v-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="User" mermaidId="n:User" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="User" id="fFUnYYiy8us-99wB4B5v-2">
