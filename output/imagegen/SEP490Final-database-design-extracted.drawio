  <diagram id="25acUSTSmQZuxEiADDTN" name="Electronic Signature Management diagrams">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class ElectronicSignatureController {\n        &lt;&lt;RestController&gt;&gt;\n        -ElectronicSignatureServiceImpl electronicSignatureService\n        +createElectronic(CreateElectronicSignatureRequest request, MultipartFile file) ResponseEntity\n        +getAll() ResponseEntity\n        +getElectronicById(UUID id) ResponseEntity\n        +updateElectronicSignature(UUID id, UpdateElectronicSignatureRequest request, MultipartFile file) ResponseEntity\n    }\n\n    class IElectronicSignatureService {\n        &lt;&lt;Interface&gt;&gt;\n        +createElectronicSignature(CreateElectronicSignatureRequest request) ElectronicSignatures\n        +getAllElectronicSignatures() List~ListElectronicResponse~\n        +getElectronicSignatureDetail(UUID id) ElectronicSignatureDetailResponse\n        +updateElectronicSignature(UUID id, UpdateElectronicSignatureRequest request, MultipartFile file) ElectronicSignatures\n    }\n\n    class ElectronicSignatureServiceImpl {\n        &lt;&lt;Service&gt;&gt;\n        -ElectronicSignatureRepository electronicSignatureRepository\n        -CurrentUser currentUser\n        -Cloudinary cloudinary\n        -CloudinaryService cloudinaryService\n        -FileStorageRepository fileStorageRepository\n        -UserKeyServiceImpl userKeyService\n        +createElectronicSignature(CreateElectronicSignatureRequest request) ElectronicSignatures\n        +getAllElectronicSignatures() List~ListElectronicResponse~\n        +getElectronicSignatureDetail(UUID id) ElectronicSignatureDetailResponse\n        +updateElectronicSignature(UUID id, UpdateElectronicSignatureRequest request, MultipartFile file) ElectronicSignatures\n        -registerLegacyKeyIfNeeded(ElectronicSignatures signature, String publicKey, Users user) void\n        -saveUserKey(RegisteredPublicKey key, Users user) UserKeys\n    }\n\n    class ElectronicSignatureRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +findById(UUID id) Optional~ElectronicSignatures~\n        +save(ElectronicSignatures signature) ElectronicSignatures\n        +getAllElectronicSignaturesById(UUID userId) List~ListElectronicResponse~\n        +getElectronicSignaturesById(UUID userId, UUID signatureId) ElectronicSignatureDetailResponse\n        +findByIdAndUserIdAndStatus(UUID id, UUID userId, ElectronicStatus status) Optional~ElectronicSignatures~\n        +findOwnedById(UUID signatureId, UUID userId) Optional~ElectronicSignatures~\n    }\n\n    class CreateElectronicSignatureRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        -String electronicSignatureName\n        -ElectronicSignatureType electronicSignatureType\n        -boolean isDefault\n        -ElectronicStatus electronicStatus\n        -String publicKey\n        -String keyCode\n        -String certificate\n        -CreateFileStorageRequest createFileStorageRequests\n    }\n\n    class UpdateElectronicSignatureRequest {\n        &lt;&lt;RequestDTO&gt;&gt;\n        -String electronicSignatureName\n        -ElectronicSignatureType electronicSignatureType\n        -boolean isDefault\n        -ElectronicStatus electronicStatus\n        -String publicKey\n    }\n\n    class ListElectronicResponse {\n        &lt;&lt;ResponseDTO&gt;&gt;\n        -UUID id\n        -String signatureName\n        -ElectronicSignatureType type\n        -ElectronicStatus status\n        -boolean isDefault\n        -LocalDate uploadAt\n        -String imageUrl\n        -String publicKey\n        -String publicKeyFingerprint\n        -KeyAlgorithm keyAlgorithm\n        -Long keySize\n    }\n\n    class ElectronicSignatureDetailResponse {\n        &lt;&lt;ResponseDTO&gt;&gt;\n        -String electronicSignatureName\n        -ElectronicSignatureType electronicSignatureType\n        -ElectronicStatus electronicSignatureStatus\n        -boolean isDefault\n        -LocalDate createAt\n        -String signatureUrl\n    }\n\n    class ElectronicSignatures {\n        &lt;&lt;Entity&gt;&gt;\n        -String electronicSignatureName\n        -ElectronicSignatureType electronicSignatureType\n        -boolean isDefault\n        -ElectronicStatus status\n        -LocalDate createdAt\n        -LocalDate updatedAt\n        -FileStorage fileStorage\n        -List~Signature~ signatures\n        -Users user\n        -UserKeys userKey\n    }\n\n    class UserKeyServiceImpl {\n        &lt;&lt;Service&gt;&gt;\n        -UserKeysRepository userKeysRepository\n        -CalculateRSA calculateRSA\n        +generateUserKey(Users user) UserKeyInfoResponse\n        +saveUserKey(Users user, String publicKey, String keyCode, String certificate) void\n        +encodePublicKey(BigInteger modulus, BigInteger exponent) String\n    }\n\n    class SignatureController {\n        &lt;&lt;RestController&gt;&gt;\n        -CurrentUser currentUser\n        -UserKeyServiceImpl userKeyService\n        +generateKey() ResponseEntity\n    }\n\n    class UserKeysRepository {\n        &lt;&lt;Repository&gt;&gt;\n        +save(UserKeys key) UserKeys\n        +findByUserIdAndKeyCode(UUID userId, String keyCode) Optional~UserKeys~\n    }\n\n    class CloudinaryService {\n        &lt;&lt;Service&gt;&gt;\n        +uploadAndSave(MultipartFile file, Users user) FileStorage\n        +download(FileStorage file) byte[]\n    }\n\n    class CurrentUser {\n        &lt;&lt;Service&gt;&gt;\n        +getCurrentUser() Users\n    }\n\n    class FileStorage {\n        &lt;&lt;Entity&gt;&gt;\n        -String filePath\n        -String originalName\n        -String mimeType\n        -Long fileSize\n        -Users user\n    }\n\n    class UserKeys {\n        &lt;&lt;Entity&gt;&gt;\n        -long keySize\n        -LocalDateTime createAt\n        -String publicKey\n        -String keyFingerprint\n        -String keyCode\n        -KeyAlgorithm keyAlgorithm\n        -KeyStatus keyStatus\n        -String certificate\n        -Users user\n    }\n\n    class Users {\n        &lt;&lt;Entity&gt;&gt;\n        -String email\n        -List~ElectronicSignatures~ electronicSignatures\n        -List~UserKeys~ userKeys\n    }\n\n    class Signature {\n        &lt;&lt;Entity&gt;&gt;\n    }\n\n    class ElectronicStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        ACTIVE\n        INACTIVE\n    }\n\n    class ElectronicSignatureType {\n        &lt;&lt;enumeration&gt;&gt;\n        DRAW\n        UPLOADED\n    }\n\n    ElectronicSignatureServiceImpl ..|&gt; IElectronicSignatureService : realizes\n    ElectronicSignatureController ..&gt; ElectronicSignatureServiceImpl : delegates\n    ElectronicSignatureController ..&gt; CreateElectronicSignatureRequest : receives\n    ElectronicSignatureController ..&gt; UpdateElectronicSignatureRequest : receives\n    ElectronicSignatureServiceImpl ..&gt; ElectronicSignatureRepository : queries and saves\n    ElectronicSignatureServiceImpl ..&gt; CurrentUser : gets owner\n    ElectronicSignatureServiceImpl ..&gt; CloudinaryService : stores image\n    ElectronicSignatureServiceImpl ..&gt; UserKeyServiceImpl : registers key\n    SignatureController ..&gt; UserKeyServiceImpl : generates RSA key\n    UserKeyServiceImpl ..&gt; UserKeysRepository : persists key\n    ElectronicSignatureRepository ..&gt; ElectronicSignatures : persists\n    ElectronicSignatureRepository ..&gt; ListElectronicResponse : projects\n    ElectronicSignatureRepository ..&gt; ElectronicSignatureDetailResponse : projects\n    ElectronicSignatures --|&gt; BaseEntity : extends\n    ElectronicSignatures --&gt; ElectronicStatus : has\n    ElectronicSignatures --&gt; ElectronicSignatureType : has\n    ElectronicSignatures \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Users : belongs to\n    ElectronicSignatures \&quot;0..*\&quot; --&gt; \&quot;1\&quot; FileStorage : uses image\n    ElectronicSignatures \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; UserKeys : uses key\n    ElectronicSignatures \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Signature : used by&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="q6YWYL-tFF6-Fazel0MW-1">
