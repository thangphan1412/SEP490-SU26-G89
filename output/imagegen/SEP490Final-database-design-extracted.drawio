  <diagram name="Class Diagram (UserManagement-View User Detail)" id="eXmoBzmoqxYo4uT6hSB4">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="CAnDmF5EashCs1ZaUeCY-0" />
        <mxCell id="CAnDmF5EashCs1ZaUeCY-1" parent="CAnDmF5EashCs1ZaUeCY-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass UserController {\n  +getAllUsers(filter, page, size)\n  +getUserById(id)\n  +createUser(request)\n  +updateUser(id, request)\n}\n\nclass IUserService {\n  +getAllUsersFiltered(filter, username, page, size)\n  +getUserById(id)\n  +createUser(request)\n  +updateUser(id, request)\n}\n\nclass UserServiceImpl {\n  +getAllUsersFiltered(filter, username, page, size)\n  +getUserById(id)\n  +createUser(request)\n  +updateUser(id, request)\n}\n\nclass CurrentUser {\n  +getCurrentUser()\n}\n\nclass UserRepository {\n  +findById(id)\n  +findByEmail(email)\n  +existsByEmail(email)\n  +searchAndFilterUsers(...)\n  +save(user)\n}\n\nclass DepartmentRepository {\n  +findByDepartmentName(name)\n}\n\nclass RoleRepository {\n  +findByRoleName(name)\n}\n\nclass UserRoleRepository {\n  +findByUser(user)\n  +save(userRole)\n}\n\nclass CompanyRepository {\n  +findByIsInternalTrue()\n  +save(company)\n}\n\nclass UserKeyServiceImpl {\n  +generateUserKey(user)\n}\n\nclass PasswordEncoder {\n  +encode(password)\n}\n\nclass EmailService {\n  +sendEmail(message)\n}\n\nclass UserFilterRequestDTO {\n  +type\n  +keyword\n  +role\n  +departmentName\n  +status\n}\n\nclass UserCreateRequestDTO {\n  +email\n  +password\n  +firstName\n  +lastName\n  +role\n  +departmentName\n  +companyName\n}\n\nclass UserUpdateRequestDTO {\n  +email\n  +password\n  +firstName\n  +lastName\n  +role\n  +departmentName\n  +companyName\n}\n\nclass UserResponseDTO {\n  +fromEntity(user)\n}\n\nclass Users {\n  +id\n  +email\n  +password\n  +firstName\n  +lastName\n  +numberPhone\n  +status\n}\n\nclass Departments {\n  +departmentName\n}\n\nclass Role {\n  +roleName\n}\n\nclass UserRole {\n  +user\n  +role\n}\n\nclass Company {\n  +companyName\n  +email\n  +registeredAddress\n  +isInternal\n}\n\nclass UserKeys {\n  +publicKey\n  +privateKey\n  +algorithm\n}\n\nclass UserStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  ACTIVE\n  INACTIVE\n}\n\nUserController --&gt; IUserService\nIUserService &lt;|.. UserServiceImpl\n\nUserServiceImpl --&gt; CurrentUser\nUserServiceImpl --&gt; UserRepository\nUserServiceImpl --&gt; DepartmentRepository\nUserServiceImpl --&gt; RoleRepository\nUserServiceImpl --&gt; UserRoleRepository\nUserServiceImpl --&gt; CompanyRepository\nUserServiceImpl --&gt; UserKeyServiceImpl\nUserServiceImpl --&gt; PasswordEncoder\nUserServiceImpl --&gt; EmailService\n\nUserServiceImpl ..&gt; UserFilterRequestDTO\nUserServiceImpl ..&gt; UserCreateRequestDTO\nUserServiceImpl ..&gt; UserUpdateRequestDTO\nUserServiceImpl ..&gt; UserResponseDTO\n\nUserRepository --&gt; Users\nDepartmentRepository --&gt; Departments\nRoleRepository --&gt; Role\nUserRoleRepository --&gt; UserRole\nCompanyRepository --&gt; Company\nUserKeyServiceImpl --&gt; UserKeys\n\nUserResponseDTO ..&gt; Users\nUsers --&gt; Departments : department\nUsers --&gt; Company : company\nUsers --&gt; UserRole : userRoles\nUserRole --&gt; Role : role\nUsers --&gt; UserKeys : keys\nUsers --&gt; UserStatus : status\n\nclassDef used fill:#FFFFFF,stroke:#333333,color:#D32F2F;\n\nclass UserController:::used\nclass IUserService:::used\nclass UserServiceImpl:::used\nclass CurrentUser:::used\nclass UserRepository:::used\nclass UserResponseDTO:::used\nclass Users:::used\nclass Departments:::used\nclass Role:::used\nclass UserRole:::used\nclass Company:::used\nclass UserStatus:::used&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7mT5ewS4FTyXX6_W3BA7-0">
          <mxCell connectable="0" parent="CAnDmF5EashCs1ZaUeCY-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;UserController&lt;/b&gt;" mermaidId="n:UserController" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=default;whiteSpace=wrap;fillColor=default;strokeColor=#333333;fontColor=#D32F2F;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;UserController&lt;/b&gt;" id="7mT5ewS4FTyXX6_W3BA7-1">
