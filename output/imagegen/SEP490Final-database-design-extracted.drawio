        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n\n    class USERS {\n        id PK\n        username\n        email\n        password\n        full_name\n        status\n        created_at\n        updated_at\n    }\n\n    class ROLE {\n        id PK\n        name\n        description\n        status\n    }\n\n    class PERMISSION_ACTION {\n        id PK\n        action_code\n        action_name\n        description\n    }\n\n    class PERMISSIONS {\n        id PK\n        project_id FK\n        role_id FK\n        action_id FK\n        status\n    }\n\n    class USER_ROLE {\n        id PK\n        user_id FK\n        role_id FK\n    }\n\n    class USER_PERMISSION {\n        id PK\n        user_id FK\n        permission_id FK\n    }\n\n    class COMPANY {\n        id PK\n        company_name\n        tax_code\n        address\n        phone\n        email\n        status\n    }\n\n    class DEPARTMENTS {\n        id PK\n        company_id FK\n        department_name\n        description\n        status\n    }\n\n    class PROJECTS {\n        id PK\n        company_id FK\n        manager_id FK\n        project_code\n        project_name\n        description\n        status\n        start_date\n        end_date\n    }\n\n    class PROJECT_MEMBER {\n        id PK\n        project_id FK\n        user_id FK\n        role_id FK\n        status\n    }\n\n    class CONTRACT_TYPES {\n        id PK\n        type_name\n        description\n        status\n    }\n\n    class CONTRACT_TEMPLATES {\n        id PK\n        company_id FK\n        contract_type_id FK\n        template_name\n        description\n        status\n    }\n\n    class CONTRACT_TEMPLATE_VERSIONS {\n        id PK\n        template_id FK\n        version_number\n        layout\n        status\n        created_at\n    }\n\n    class CONTRACTS {\n        id PK\n        project_id FK\n        contract_type_id FK\n        template_id FK\n        template_version_id FK\n        created_by FK\n        contract_number\n        title\n        status\n        start_date\n        end_date\n        content\n    }\n\n    class CONTRACT_ATTRIBUTE {\n        id PK\n        contract_type_id FK\n        attribute_name\n        data_type\n        required\n    }\n\n    class CONTRACT_ATTRIBUTE_VALUES {\n        id PK\n        contract_id FK\n        attribute_id FK\n        attribute_value\n    }\n\n    class CONTRACT_POSITIONS {\n        id PK\n        contract_id FK\n        position_code\n        position_name\n        position_x\n        position_y\n        width\n        height\n    }\n\n    class CONTRACT_STATUS_HISTORY {\n        id PK\n        contract_id FK\n        changed_by FK\n        old_status\n        new_status\n        reason\n        created_at\n    }\n\n    class CONTRACT_APPROVALS {\n        id PK\n        contract_id FK\n        approver_id FK\n        status\n        comment\n        approved_at\n    }\n\n    class APPROVALS {\n        id PK\n        contract_id FK\n        user_id FK\n        approval_type\n        status\n        comment\n        created_at\n    }\n\n    class WORKFLOW {\n        id PK\n        company_id FK\n        workflow_name\n        description\n        status\n    }\n\n    class WORKFLOW_STEPS {\n        id PK\n        workflow_id FK\n        step_name\n        step_order\n        role_code\n        status\n    }\n\n    class CONTRACT_TYPE_WORKFLOW {\n        id PK\n        contract_type_id FK\n        workflow_id FK\n    }\n\n    class CONTRACT_TYPE_WORKFLOW_STEP {\n        id PK\n        contract_type_workflow_id FK\n        workflow_step_id FK\n    }\n\n    class CONTRACT_WORKFLOW_STEP_INSTANCE {\n        id PK\n        contract_id FK\n        workflow_step_id FK\n        assigned_user_id FK\n        status\n        completed_at\n    }\n\n    class FILE_STORAGE {\n        id PK\n        uploaded_by FK\n        file_name\n        file_path\n        file_type\n        file_size\n        storage_provider\n    }\n\n    class ELECTRONIC_SIGNATURES {\n        id PK\n        user_id FK\n        file_storage_id FK\n        signature_name\n        signature_type\n        is_default\n        status\n    }\n\n    class USER_KEYS {\n        id PK\n        user_id FK\n        algorithm\n        key_code\n        key_size\n        public_key\n        public_key_fingerprint\n        created_at\n    }\n\n    class SIGNATURE {\n        id PK\n        contract_id FK\n        user_id FK\n        electronic_signature_id FK\n        file_storage_id FK\n        signature_status\n        action\n        document_hash\n        signed_at\n    }\n\n    class EXTERNAL_ACCESS {\n        id PK\n        contract_id FK\n        created_by FK\n        access_token\n        expired_at\n        status\n    }\n\n    class NOTIFICATIONS {\n        id PK\n        user_id FK\n        contract_id FK\n        title\n        message\n        is_read\n        created_at\n    }\n\n    class TIMELINE {\n        id PK\n        project_id FK\n        timeline_name\n        start_date\n        end_date\n        status\n    }\n\n    class TIMELINE_TASK {\n        id PK\n        timeline_id FK\n        task_name\n        start_date\n        end_date\n        status\n    }\n\n    class TIMELINE_CONTRACT {\n        id PK\n        timeline_id FK\n        contract_id FK\n    }\n\n    class DELIVERABLE {\n        id PK\n        timeline_task_id FK\n        deliverable_name\n        description\n        status\n        due_date\n    }\n\n    class ACTIVITY_LOG {\n        id PK\n        user_id FK\n        contract_id FK\n        action\n        description\n        created_at\n    }\n\n    class PROPOSALS {\n        id PK\n        project_id FK\n        created_by FK\n        title\n        description\n        status\n        created_at\n    }\n\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; USER_ROLE : has\n    ROLE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; USER_ROLE : assigned\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; USER_PERMISSION : has\n    PERMISSIONS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; USER_PERMISSION : grants\n\n    PROJECTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PERMISSIONS : contains\n    ROLE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PERMISSIONS : receives\n    PERMISSION_ACTION \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PERMISSIONS : defines\n\n    COMPANY \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DEPARTMENTS : owns\n    COMPANY \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROJECTS : owns\n    COMPANY \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TEMPLATES : owns\n    COMPANY \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WORKFLOW : owns\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROJECTS : manages\n\n    PROJECTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROJECT_MEMBER : contains\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROJECT_MEMBER : joins\n    ROLE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROJECT_MEMBER : assigned\n\n    CONTRACT_TYPES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TEMPLATES : categorizes\n    CONTRACT_TEMPLATES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TEMPLATE_VERSIONS : versions\n\n    PROJECTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACTS : contains\n    CONTRACT_TYPES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACTS : categorizes\n    CONTRACT_TEMPLATES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACTS : uses\n    CONTRACT_TEMPLATE_VERSIONS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACTS : uses\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACTS : creates\n\n    CONTRACT_TYPES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_ATTRIBUTE : defines\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_ATTRIBUTE_VALUES : has\n    CONTRACT_ATTRIBUTE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_ATTRIBUTE_VALUES : stores\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_POSITIONS : contains\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_STATUS_HISTORY : tracks\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_STATUS_HISTORY : changes\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_APPROVALS : requires\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_APPROVALS : approves\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; APPROVALS : has\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; APPROVALS : performs\n\n    WORKFLOW \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WORKFLOW_STEPS : contains\n\n    CONTRACT_TYPES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TYPE_WORKFLOW : uses\n    WORKFLOW \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TYPE_WORKFLOW : assigned\n\n    CONTRACT_TYPE_WORKFLOW \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TYPE_WORKFLOW_STEP : contains\n    WORKFLOW_STEPS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_TYPE_WORKFLOW_STEP : defines\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_WORKFLOW_STEP_INSTANCE : executes\n    WORKFLOW_STEPS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_WORKFLOW_STEP_INSTANCE : instantiates\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CONTRACT_WORKFLOW_STEP_INSTANCE : assigned\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FILE_STORAGE : uploads\n\n    FILE_STORAGE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ELECTRONIC_SIGNATURES : stores\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ELECTRONIC_SIGNATURES : owns\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; USER_KEYS : owns\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SIGNATURE : receives\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SIGNATURE : signs\n    ELECTRONIC_SIGNATURES \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SIGNATURE : uses\n    FILE_STORAGE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SIGNATURE : stores\n\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EXTERNAL_ACCESS : shares\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EXTERNAL_ACCESS : creates\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; NOTIFICATIONS : receives\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; NOTIFICATIONS : triggers\n\n    PROJECTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TIMELINE : contains\n    TIMELINE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TIMELINE_TASK : contains\n\n    TIMELINE \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TIMELINE_CONTRACT : links\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TIMELINE_CONTRACT : links\n\n    TIMELINE_TASK \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DELIVERABLE : produces\n\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ACTIVITY_LOG : performs\n    CONTRACTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ACTIVITY_LOG : logs\n\n    PROJECTS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROPOSALS : contains\n    USERS \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PROPOSALS : creates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XjJW54dEqWwUaikB7SvB-0">
